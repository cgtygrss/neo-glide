# Live inventory requires `npm run build:release` plus this value set to true in
# a local .env.release file used only for a signed release build.
VITE_ADMOB_LIVE_RELEASE=false

# Replace with ad unit IDs created in your own AdMob account.
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_REWARDED_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_INTERSTITIAL_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_REWARDED_INTERSTITIAL_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_REWARDED_INTERSTITIAL_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
