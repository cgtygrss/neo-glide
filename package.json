{
  "name": "neon-glide",
  "displayName": "Neo Glide",
  "version": "1.3.0",
  "description": "An exciting neon-themed gliding game",
  "author": "Cagatay Gurses",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "legal:build": "node scripts/build-legal.mjs",
    "prebuild": "npm run legal:build",
    "prebuild:release": "npm run legal:build",
    "prebuild:ads-test": "npm run legal:build",
    "predev": "npm run legal:build",
    "dev": "vite",
    "host": "vite --host",
    "build": "vite build",
    "build:ads-test": "vite build --mode production",
    "build:release": "vite build --mode release",
    "verify:ios-ads": "node scripts/verify-ios-admob.mjs",
    "test": "node --test test/**/*.test.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open ios",
    "ios:build": "npm run build && cap sync ios && cap open ios",
    "dev:admin": "vite --config vite.admin.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "store:sync": "node scripts/sync-store-catalog.js",
    "test:backend": "npm --prefix backend test",
    "test:emulators": "tools/ci/node_modules/.bin/firebase emulators:exec --project demo-neo-glide --only auth,firestore \"node scripts/ci/require-emulators.mjs && node --test backend/test/emulator.test.js\"",
    "version:sync": "node scripts/ci/version.mjs",
    "test:ci": "node --test scripts/ci/test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "firebase": "^13.0.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
