{
  "appId": "com.cgtygrssgame.neonglide",
  "appName": "Neo Glide",
  "webDir": "dist",
  "server": {
    "cleartext": true
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Neo Glide",
    "backgroundColor": "#0b1725"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b1725",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#00ffff"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0b1725"
    }
  }
}
